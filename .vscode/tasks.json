{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-O2",
                "${file}",
                "-o",
                "${fileDirname}/main",
                "&&",
                "${fileDirname}/main",
                "<",
                "${workspaceFolder}/codeforces/input.txt",
                ">",
                "${workspaceFolder}/codeforces/output.txt"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}